# Copy this file to .env and fill in a key. .env is read by server.py on start.
# Free, long-lived key: https://console.groq.com/keys
VERIFAI_LLM_API_KEY=gsk_your_key_here
# Optional: any OpenAI-compatible provider
# VERIFAI_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# VERIFAI_LLM_MODEL=gpt-4o-mini
# Optional: change the port (default 8765)
# VERIFAI_PORT=8765
# Optional: real WildGuard (see WILDGUARD_SETUP.md)
# WILDGUARD_URL=https://YOUR-ADDRESS.trycloudflare.com/v1/completions
# WILDGUARD_KEY=my-secret
# WILDGUARD_MODEL=allenai/wildguard
